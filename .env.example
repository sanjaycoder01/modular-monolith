MONGODB_URI=mongodb://127.0.0.1:27017

# Outbox worker (in-process; polls orders_db.outbox)
OUTBOX_WORKER_ENABLED=true
OUTBOX_WORKER_POLL_MS=2000
OUTBOX_WORKER_BATCH_SIZE=10
OUTBOX_RETRY_BASE_MS=5000
OUTBOX_RETRY_MAX_MS=300000
# Separate stale-reclaim process (npm run worker:outbox-stale)
OUTBOX_STALE_WORKER_ENABLED=true
OUTBOX_STALE_PROCESSING_MS=300000
OUTBOX_STALE_RECLAIM_POLL_MS=30000

# Payments outbox worker (in-process; polls payments_db.outbox)
PAYMENTS_OUTBOX_WORKER_ENABLED=true
PAYMENTS_OUTBOX_WORKER_POLL_MS=2000
PAYMENTS_OUTBOX_WORKER_BATCH_SIZE=10
PAYMENTS_OUTBOX_RETRY_BASE_MS=5000
PAYMENTS_OUTBOX_RETRY_MAX_MS=300000
PAYMENT_MAX_ATTEMPTS=3
MOCK_GATEWAY_DEFAULT_OUTCOME=SUCCESS
MOCK_GATEWAY_DELAY_MS=0
MOCK_WEBHOOK_SECRET=local-dev-webhook-secret

# Payment attempt reconciliation (in-process with npm start, or npm run worker:payment-reconcile)
PAYMENT_RECONCILE_WORKER_ENABLED=true
PAYMENT_RECONCILE_WORKER_POLL_MS=30000
PAYMENT_RECONCILE_STALE_MS=5000
PAYMENT_RECONCILE_BATCH_SIZE=20
